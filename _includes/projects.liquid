{%- comment -%}
  Local override of al_folio_core's projects.liquid (project card).
  The card body is a flex column so the GitHub icon sits at the bottom of every card.
  `wide` (set in projects.md) renders a horizontal card; `card_img` overrides `img` for the card only; `card_blurb` adds a paragraph to wide cards.
{%- endcomment -%}
{%- assign card_img = project.card_img | default: project.img -%}
<div class="col mb-4">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable{% if wide %} card-wide{% endif %}">
      {% if card_img %}
        {% include figure.liquid loading="eager" path=card_img sizes="250px" alt="project thumbnail" class="card-img-top" %}
      {% endif %}
      <div class="card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        {% if wide and project.card_blurb %}<p class="card-text card-blurb">{{ project.card_blurb }}</p>{% endif %}
        {% if project.github %}
          <div class="card-github" data-toggle="tooltip" title="Code Repository">
            <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
          </div>
        {% endif %}
      </div>
    </div>
  </a>
</div>
